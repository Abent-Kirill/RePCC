root = true

# ==========================================
# 1. Глобальные настройки для всех файлов
# ==========================================
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# Для XML/JSON/YAML обычно используют отступ в 2 пробела
[*.{json,xml,yml,yaml}]
indent_size = 2

# ==========================================
# 2. Настройки стилей для файлов C# (*.cs)
# ==========================================
[*.cs]
# Форматирование пространств имен (C# 10+) — уходим от фигурных скобок {}
csharp_style_namespace_declarations = file_scoped:warning

# Модификаторы доступа
dotnet_style_require_accessibility_modifiers = always:warning
csharp_preferred_modifier_order = public,private,protected,internal,file,final,abstract,virtual,sealed,override,static,readonly,extern,unsafe,volatile,async:suggestion

# Использование неявной типизации (var)
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion

# Настройки чистоты кода (Clean Code) и синтаксического сахара
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_constructors = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion

# Использование современных фич языка (Pattern Matching, Свитчи)
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_style_conditional_delegate_call = true:suggestion

# Стили для пустых строк и фигурных скобок (Allman style — скобка на новой строке)
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# Оптимизация и сортировка директив using
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# ==========================================
# 3. Правила именования (Naming Conventions)
# ==========================================

# Интерфейсы должны начинаться с буквы I
dotnet_naming_rule.interface_should_be_begun_with_i.severity = warning
dotnet_naming_rule.interface_should_be_begun_with_i.symbols = interface_symbols
dotnet_naming_rule.interface_should_be_begun_with_i.style = i_prefix_style

dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.i_prefix_style.required_prefix = I
dotnet_naming_style.i_prefix_style.capitalization = pascal_case

# Приватные поля должны начинаться с подчеркивания (_camelCase)
dotnet_naming_rule.private_fields_should_start_with_underscore.severity = suggestion
dotnet_naming_rule.private_fields_should_start_with_underscore.symbols = private_fields_symbols
dotnet_naming_rule.private_fields_should_start_with_underscore.style = underscore_style

dotnet_naming_symbols.private_fields_symbols.applicable_kinds = field
dotnet_naming_symbols.private_fields_symbols.applicable_accessibilities = private
dotnet_naming_style.underscore_style.required_prefix = _
dotnet_naming_style.underscore_style.capitalization = camel_case

# Классы, методы, свойства — PascalCase
dotnet_naming_rule.types_and_members_should_be_pascal_case.severity = warning
dotnet_naming_rule.types_and_members_should_be_pascal_case.symbols = types_and_members_symbols
dotnet_naming_rule.types_and_members_should_be_pascal_case.style = pascal_case_style

dotnet_naming_symbols.types_and_members_symbols.applicable_kinds = class, struct, interface, enum, property, method, event
dotnet_naming_style.pascal_case_style.capitalization = pascal_case